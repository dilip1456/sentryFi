# Environment variables — never commit secrets
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Android (Capacitor) build artifacts — keep the native project source, not build output
android/.gradle
android/build
android/app/build
android/capacitor-cordova-android-plugins/build
android/local.properties

# Misc build caches
tsconfig.app.tsbuildinfo
supabase/.temp

# Signing material — never commit keystores or certs; CI decodes these from
# a GitHub Actions secret at build time instead (see build-apk.yml)
*.keystore
*.jks
*.pem
*.p12
*.pfx
*.b64
RELEASE_KEYSTORE_CREDENTIALS.txt

# Playwright (QA harness)
playwright-report/
test-results/
blob-report/

# Leftovers from the 2026-10 history scrub (local clones / mirrors) — never
# commit these; they contain pre-scrub history.
sentryfi-history-scrubbed/
sentryFi-scrub/
*.bfg-report/

# Claude's local command-runner bridge (machine-specific automation, not app code)
_shell/
_trash/
